{
  "name": "streamctrl-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first football graphics control for vMix.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm --parallel --filter @streamctrl/server --filter @streamctrl/control --filter @streamctrl/overlay run dev",
    "dev:server": "pnpm --filter @streamctrl/server dev",
    "dev:control": "pnpm --filter @streamctrl/control dev",
    "dev:overlay": "pnpm --filter @streamctrl/overlay dev",
    "start": "pnpm --filter @streamctrl/server start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest --config vitest.workspace.ts run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "socket.io-client": "4.8.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
